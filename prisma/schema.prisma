generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth Required Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password      String?   // For credentials auth
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]
  trades   Trade[]

  @@map("users")
}

model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// Trading Journal Models
model Trade {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")

  // Trade Details
  symbol    String
  market    String   // STOCK, FOREX, CRYPTO, FUTURES, OPTIONS
  side      String   // LONG, SHORT

  // Price Points
  entryPrice  Decimal  @map("entry_price") @db.Decimal(18, 8)
  exitPrice   Decimal? @map("exit_price") @db.Decimal(18, 8)
  stopLoss    Decimal? @map("stop_loss") @db.Decimal(18, 8)
  target      Decimal? @db.Decimal(18, 8)

  // Position Size
  quantity    Decimal  @db.Decimal(18, 8)

  // Results
  result      String?  // WIN, LOSS, BREAKEVEN, OPEN
  pnl         Decimal? @db.Decimal(18, 2) // Profit & Loss
  pnlPercent  Decimal? @map("pnl_percent") @db.Decimal(10, 2)
  riskReward  Decimal? @map("risk_reward") @db.Decimal(10, 2)

  // Psychology & Notes
  emotions    String[] @default([])
  confidence  Int?     // 1-10 scale
  notes       String?  @db.Text
  strategy    String?

  // Timing
  entryTime   DateTime @map("entry_time")
  exitTime    DateTime? @map("exit_time")
  timeframe   String   // 1m, 5m, 15m, 1h, 4h, 1d, etc.

  // Metadata
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([symbol])
  @@index([entryTime])
  @@map("trades")
}
